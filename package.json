{
  "name": "louisville-food-safe",
  "private": true,
  "description": "Interactive map of Louisville restaurant health inspections",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "packages/core",
    "pipeline"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "npm test --workspaces && node --test checks/rules.test.mjs .claude/hooks/guard.test.mjs",
    "check:rules": "node checks/run.mjs",
    "test:coverage": "npm run test:coverage -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run e2e -w apps/web --"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
