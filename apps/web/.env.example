# Copy to .env and fill in. Vite only exposes variables that start with VITE_.

# Supabase project (Settings -> API). The anon key is safe to ship to browsers;
# Row Level Security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Address autocomplete for watch areas (Geoapify). Restrict the key by referrer
# to localhost:5173 and your deployed domain.
VITE_GEOAPIFY_KEY=

# Optional: Supabase Edge Function URL for feedback. If unset, feedback is
# inserted straight into the `feedback` table.
VITE_FEEDBACK_FUNCTION_URL=
