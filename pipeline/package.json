{
  "name": "@lfs/pipeline",
  "private": true,
  "description": "Loads Louisville Metro inspection data into Supabase, plus maintenance jobs",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "seed:facilities": "node seed_facilities.js",
    "seed:inspections": "node seed_inspections.js",
    "seed:violations": "node seed_violations.js",
    "seed:categories": "node seed_categories.js",
    "overlay": "node overlay_geometry.js",
    "geo": "node geocode_missing.js",
    "archive": "node archive-old-inspections.js",
    "accuracy-check": "node etl-accuracy-check.js",
    "bullitt": "node regions/bullitt/ingest.js",
    "bullitt:retry": "node regions/bullitt/ingest.js --retry-failures",
    "bullitt:redo": "node regions/bullitt/ingest.js --redo-geocoding"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@supabase/supabase-js": "^2.53.0",
    "dotenv": "^17.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13"
  }
}
